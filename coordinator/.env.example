# Copy to .env for local development. Never commit the real .env file
# (it's already in .gitignore) — job description § Technical and Ownership
# Requirements: "Credentials must be stored securely and must not be
# embedded in source code."

# Required for SMS/missed-call free-text extraction and message drafting.
# Not required to run the website-inquiry channel or the test suite.
ANTHROPIC_API_KEY=

# Protects /admin/* routes. Required before any real deployment — see
# docs/go-live-checklist.md. Left unset locally is fine for the pilot sandbox.
ADMIN_TOKEN=

PORT=3000
