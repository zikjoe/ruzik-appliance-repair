# Copy to .env for local development. Never commit the real .env file
# (it's already in .gitignore) — job description § Technical and Ownership
# Requirements: "Credentials must be stored securely and must not be
# embedded in source code."

# Required for SMS/missed-call free-text extraction and message drafting.
# Not required to run the website-inquiry channel or the test suite.
ANTHROPIC_API_KEY=

# Protects /admin/* routes. Required before any real deployment — see
# docs/go-live-checklist.md. Left unset locally is fine for the pilot sandbox.
ADMIN_TOKEN=

# Real-time owner alerts (src/notify) — fires on every escalation and every
# message that lands in the approval queue, per config/notifications.json.
# Leave unset and alerts just log a "skipped, no credentials" audit entry
# instead of failing — same graceful-no-op pattern as ANTHROPIC_API_KEY.

# Email via SMTP. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your address, SMTP_PASS=a Gmail *app password* (not your login
# password — generate one at https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# SMS via Twilio (same account the SMS/missed-call channels will eventually
# use). TWILIO_FROM_NUMBER must be a number you've provisioned in Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

PORT=3000
